{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "runClient",
      "request": "launch",
      "mainClass": "net.minecraftforge.legacydev.MainClient",
      "projectName": "Euphoria",
      "cwd": "${workspaceFolder}/run",
      "console": "internalConsole",
      "vmArgs": "-Dnet.minecraftforge.gradle.GradleStart.csvDir=${workspaceFolder}/build/extractMappings",
      "env": {
        "MCP_TO_SRG": "${workspaceFolder}/build/createSrgToMcp/output.srg",
        "MOD_CLASSES": "Euphoria%%${workspaceFolder}/build/classes/java/main;Euphoria%%${workspaceFolder}/build/resources/main",
        "mainClass": "net.minecraft.launchwrapper.Launch",
        "MCP_MAPPINGS": "stable_39-1.12",
        "FORGE_VERSION": "14.23.5.2860",
        "assetIndex": "1.12",
        "assetDirectory": "${userHome}/.gradle/caches/forge_gradle/assets",
        "nativesDirectory": "${workspaceFolder}/build/natives",
        "FORGE_GROUP": "net.minecraftforge",
        "tweakClass": "net.minecraftforge.fml.common.launcher.FMLTweaker",
        "MC_VERSION": "1.12.2"
      }
    },
    {
      "type": "java",
      "name": "runServer",
      "request": "launch",
      "mainClass": "net.minecraftforge.legacydev.MainServer",
      "projectName": "Euphoria",
      "cwd": "${workspaceFolder}/run/server",
      "console": "internalConsole",
      "vmArgs": "-Dnet.minecraftforge.gradle.GradleStart.csvDir=${workspaceFolder}/build/extractMappings",
      "args": "nogui",
      "env": {
        "MCP_TO_SRG": "${workspaceFolder}/build/createSrgToMcp/output.srg",
        "MOD_CLASSES": "Euphoria%%${workspaceFolder}/build/classes/java/main;Euphoria%%${workspaceFolder}/build/resources/main",
        "mainClass": "net.minecraft.launchwrapper.Launch",
        "MCP_MAPPINGS": "stable_39-1.12",
        "FORGE_VERSION": "14.23.5.2860",
        "FORGE_GROUP": "net.minecraftforge",
        "tweakClass": "net.minecraftforge.fml.common.launcher.FMLServerTweaker",
        "MC_VERSION": "1.12.2"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug Fullstack",
      "configurations": [
        "runServer",
        "runClient"
      ],
      "stopAll": true
    }
  ]
}